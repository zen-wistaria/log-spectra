### Server
APP_NAME="LogSpectra"
APP_AUTHOR="Anri"
APP_COPYRIGHT="Zen"
APP_COPYRIGHT_YEAR="2026"
APP_VERSION="v1.0.0"
AUTH_URL="http://${DOMAIN}:3000/api/auth"
AUTH_SECRET="randomstring"
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=logspectra
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}?schema=public"
AGENT_TIMEOUT=300  # Default 600 seconds
FASTAPI_URL=http://127.0.0.1:8000

### FastApi & Server
MAX_UPLOAD_SIZE_MB=100 # Default 50

### AbuseIPDB
ABUSEIPDB_API_KEY= # Get from https://www.abuseipdb.com/account/api
