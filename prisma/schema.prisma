// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["linux-musl", "native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Agents {
  id          String    @id @default(cuid())
  name        String
  description String?
  hostname    String?
  ip_address  String?
  os          String?
  machine_id  String?   @map("machine_id")
  version     String?
  status      String    @default("offline")
  last_seen   DateTime?
  user_id     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tokens       ApiTokens[]
  anomaly_logs AnomalyLogs[]
  user        Users?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("agents")
}

model AnomalyLogs {
  id                    Int       @id @default(autoincrement())
  agent_id              String
  ip                    String
  request_count         Int       @default(0)
  error_count           Int       @default(0)
  request_per_second    Float     @default(0)
  unique_endpoint_ratio Float     @default(0)
  risk_score            Float     @default(0)
  risk_category         String    @default("LOW")
  risk_reasons          Json      @default("[]")
  resolved_mark         Boolean   @default(false)
  resolved_at           DateTime?
  resolved_notes        String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  agent Agents @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, ip])
  @@map("anomaly_logs")
}

model ApiTokens {
  id         Int       @id @default(autoincrement())
  agent_id   String
  token      String    @unique
  is_active  Boolean   @default(true)
  last_used  DateTime?
  user_id    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  agent Agents @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  user  Users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("api_tokens")
}

model Users {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  emailVerified DateTime?  @map("email_verified")
  image         String?
  username      String     @unique
  password      String
  role          String     @default("admin")
  agents        Agents[]
  tokens        ApiTokens[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("users")
}
