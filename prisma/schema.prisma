// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["linux-musl", "native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id          String    @id @default(cuid())
  name        String
  description String?
  hostname    String?
  ip_address  String?
  os          String?
  machine_id  String?   @map("machine_id")
  version     String?
  status      Boolean   @default(false)
  last_seen   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tokens       ApiToken[]
  anomaly_logs AnomalyLog[]

  @@map("agents")
}

model AnomalyLog {
  id                    Int      @id @default(autoincrement())
  agent_id              String
  ip                    String
  request_count         Int      @default(0)
  error_count           Int      @default(0)
  request_per_second    Float    @default(0)
  unique_endpoint_ratio Float    @default(0)
  risk_score            Float    @default(0)
  risk_category         String   @default("LOW")
  risk_reasons          Json     @default("[]")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@unique([agent_id, ip])
  @@map("anomaly_logs")
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  agent_id   String
  token      String    @unique
  is_active  Boolean   @default(true)
  last_used  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  agent Agent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}
